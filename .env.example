# ─────────────────────────────────────────────────────────────────────
# Project Sentinel - Environment Configuration
# Copy this file to .env for local development:  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════════════════
# Application Settings
# ═══════════════════════════════════════════════════════════════════════
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_LOG_LEVEL=debug
# APP_TITLE=Project Sentinel
# APP_VERSION=0.1.0

# ═══════════════════════════════════════════════════════════════════════
# Kafka Configuration
# ═══════════════════════════════════════════════════════════════════════
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TELEMETRY_RAW=telemetry-raw
KAFKA_TOPIC_TELEMETRY_ENRICHED=telemetry-enriched
KAFKA_TOPIC_ANOMALY_EVENTS=anomaly-events
KAFKA_CONSUMER_GROUP_ANOMALY=sentinel-anomaly-engine
KAFKA_CONSUMER_GROUP_GOVERNANCE=sentinel-governance-engine
KAFKA_CONSUMER_GROUP_STORAGE=sentinel-storage-writer
KAFKA_ACKS=1
KAFKA_REQUEST_TIMEOUT_MS=30000
KAFKA_BUFFER_MAX_EVENTS=10000
KAFKA_PRODUCER_LINGER_MS=5
KAFKA_PRODUCER_BATCH_SIZE=16384

# ═══════════════════════════════════════════════════════════════════════
# Redis Configuration
# ═══════════════════════════════════════════════════════════════════════
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0
REDIS_CONNECTION_POOL_SIZE=20
REDIS_SOCKET_TIMEOUT=2.0
REDIS_SOCKET_CONNECT_TIMEOUT=2.0

# ═══════════════════════════════════════════════════════════════════════
# Database (TimescaleDB) Configuration
# ═══════════════════════════════════════════════════════════════════════
# These are also used by docker-compose for the TimescaleDB container
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_dev
POSTGRES_DB=sentinel_db

# Application database settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentinel_db
DB_USER=sentinel
DB_PASSWORD=sentinel_dev
DB_MIN_POOL_SIZE=5
DB_MAX_POOL_SIZE=20

# ═══════════════════════════════════════════════════════════════════════
# Anomaly Detection Settings
# ═══════════════════════════════════════════════════════════════════════
ANOMALY_WINDOW_DURATION_SECONDS=60
ANOMALY_LOOP_THRESHOLD=10
ANOMALY_CASCADE_RATE_THRESHOLD=1000.0
ANOMALY_SPIKE_Z_THRESHOLD=3.0
ANOMALY_MIN_EVENTS_FOR_SPIKE=2

# ═══════════════════════════════════════════════════════════════════════
# Governance Settings
# ═══════════════════════════════════════════════════════════════════════
GOVERNANCE_SOFT_LIMIT_PERCENT=80
GOVERNANCE_COOLDOWN_SECONDS=300
# GOVERNANCE_CIRCUIT_BREAKER_DEFAULT_TTL=

# ═══════════════════════════════════════════════════════════════════════
# Notification Settings
# ═══════════════════════════════════════════════════════════════════════
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_BASE_RETRY_DELAY_SECONDS=1.0
NOTIFICATION_WEBHOOK_TIMEOUT_SECONDS=10.0

# ═══════════════════════════════════════════════════════════════════════
# Security Settings
# ═══════════════════════════════════════════════════════════════════════
SECURITY_API_KEY_HEADER=X-API-Key
SECURITY_RATE_LIMIT_PER_AGENT=100
SECURITY_RATE_LIMIT_PER_ORG=1000
